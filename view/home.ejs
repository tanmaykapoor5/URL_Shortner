<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <h1>URL Shortner</h1>
    <% if (locals.id) { %>
        <p>URL Generated: http://localhost:8001/<%= id %></p>
     
    <% } %>
    <form method="POST" action="/url/">
        <div>
            <label for="">Enter Your URL</label>
            <input type="text" placeholder="http://example.com" name="url">
            <button type="submit">Submit</button>
        </div>
        
    </form>
</body>
</html>